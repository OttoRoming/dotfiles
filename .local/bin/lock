#!/usr/bin/env bash

source "$HOME/.cache/theme/colors.sh"

session_is_wayland() {
  if [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
    return 0
  fi

  # Xwayland sets DISPLAY as well, so only trust WAYLAND_DISPLAY when there
  # is no X display.
  if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
    return 0
  fi

  return 1
}

if session_is_wayland; then
  if ! command -v swaylock >/dev/null 2>&1; then
    echo "lock: swaylock is not installed" >&2
    exit 1
  fi

  exec swaylock --font 'Hack Nerd Font' --font-size 16 \
    -c "#$background" \
    --inside-caps-lock-color "#$bright_yellow" \
    --inside-ver-color "#$background" \
    --separator-color "#$black" \
    --key-hl-color "#$primary" \
    --line-color "#$black" \
    --ring-color "#$background" \
    --ring-ver-color "#$background" \
    --ring-clear-color "#$background" \
    --text-color "#$foreground" \
    --text-clear-color "#$foreground" \
    --line-ver-color "#$black" \
    --text-ver-color "#$foreground" \
    --inside-wrong-color "#$bright_red" \
    --inside-clear-color "#$bright_yellow" \
    --line-wrong-color "#$black" \
    --line-clear-color "#$black" \
    \
    --text-wrong-color "#$foreground" \
    --inside-color "#$bright_black" \
    \
    --ring-caps-lock-color "#$background" \
    --ring-wrong-color "#$background" \
    --line-caps-lock-color "#$black" \
    --text-caps-lock-color "#$foreground" \
    --layout-bg-color "#$background"
fi

if ! command -v i3lock >/dev/null 2>&1; then
  echo "lock: i3lock is not installed" >&2
  exit 1
fi

exec i3lock -c "$background"
