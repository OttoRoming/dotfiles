#!/usr/bin/env bash

source "$HOME/.cache/theme/colors.sh"

font='DroidSansM Nerd Font 12'

if command -v bemenu >/dev/null 2>&1; then
  exec bemenu --ignorecase --list 25 --counter always --prompt '' --width-factor 0.26 --center --cw 2 --fn "$font" \
    --tb "#${primary}cc"    --tf "#${foreground}ff" \
    --fb "#${background}cc" --ff "#${foreground}ff" \
    --nb "#${background}cc" --nf "#${foreground}ff" \
    --ab "#${background}cc" --af "#${foreground}ff" \
    --hb "#${primary}cc"    --hf "#${foreground}ff"
fi

if command -v dmenu >/dev/null 2>&1; then
  exec dmenu -i -l 25 -p '' -fn "$font" \
    -nb "#${background}" -nf "#${foreground}" \
    -sb "#${primary}"    -sf "#${foreground}"
fi

printf 'menu: neither bemenu nor dmenu is installed\n' >&2
exit 1
